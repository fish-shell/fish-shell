complete -c pkgconf -fa '(command pkgconf --list-all | string replace -r " (.*)" "\t\$1")'

# options
complete -c pkgconf -l help -s h
complete -c pkgconf -l about -d "print pkgconf version and license to stdout"
complete -c pkgconf -l version -d "print supported pkg-config version to stdout"
complete -c pkgconf -l verbose -d "print additional information"
complete -c pkgconf -l atleast-pkgconfig-version -x -d "check whether or not pkgconf is compatible with a specified pkg-config version"
complete -c pkgconf -l errors-to-stdout -d "print all errors on stdout instead of stderr"
complete -c pkgconf -l print-errors -d "ensure all errors are printed"
complete -c pkgconf -l short-errors -d "be less verbose about some errors"
complete -c pkgconf -l silence-errors -d "explicitly be silent about errors"
complete -c pkgconf -l debug -d 'print non-fatal warnings and debugging messages'
complete -c pkgconf -l list-all -d "list all known packages"
complete -c pkgconf -l list-package-names -d "list all known package names"
complete -c pkgconf -l simulate -d "simulate walking the calculated dependency graph"
complete -c pkgconf -l no-cache -d "do not cache already seen packages when walking the dependency graph"
complete -c pkgconf -l log-file -r -d "write an audit log to a specified file"
complete -c pkgconf -l with-path -xa "(__fish_complete_directories)" -d "adds a directory to the search path"
complete -c pkgconf -l define-prefix -d "override the prefix variable with one that is guessed based on the location of the .pc file"
complete -c pkgconf -l dont-define-prefix -d "do not override the prefix variable under any circumstances"
complete -c pkgconf -l prefix-variable -x -d "sets the name of the variable that pkgconf considers to be the package prefix"
complete -c pkgconf -l dont-relocate-paths -d "disables path relocation support"

# cross-compilation personality support:
complete -c pkgconf -l personality -r -d "sets the personality to 'triplet' or a file named 'filename'"
complete -c pkgconf -l dump-personality -d "dumps details concerning selected personality"

# checking specific pkg-config database entries
complete -c pkgconf -l atleast-version -x -d "require a specific version of a module"
complete -c pkgconf -l exact-version -x -d "require an exact version of a module"
complete -c pkgconf -l max-version -x -d "require a maximum version of a module"
complete -c pkgconf -l exists -d "check whether or not a module exists"
complete -c pkgconf -l uninstalled -d "check whether or not an uninstalled module will be used"
complete -c pkgconf -l no-uninstalled -d "never use uninstalled modules when satisfying dependencies"
complete -c pkgconf -l no-provides -d "do not use 'provides' rules to resolve dependencies"
complete -c pkgconf -l maximum-traverse-depth -x -d "maximum allowed depth for dependency graph (-1 for unlimited)"
complete -c pkgconf -l static -d "be more aggressive when computing dependency graph (for static linking)"
complete -c pkgconf -l shared -d "use a simplified dependency graph (usually default)"
complete -c pkgconf -l pure -d "optimize a static dependency graph as if it were a normal dependency graph"
complete -c pkgconf -l env-only -d "look only for package entries in PKG_CONFIG_PATH"
complete -c pkgconf -l ignore-conflicts -d "ignore 'conflicts' rules in modules"
complete -c pkgconf -l validate -d "validate specific .pc files for correctness"

# querying specific pkg-config database fields:
complete -c pkgconf -l define-variable -x -d "define variable 'varname' as 'value'"
complete -c pkgconf -l variable -x -d "print specified variable entry to stdout"
complete -c pkgconf -l cflags -d "print required CFLAGS to stdout"
complete -c pkgconf -l cflags-only-I -d "print required include-dir CFLAGS to stdout"
complete -c pkgconf -l cflags-only-other -d "print required non-include-dir CFLAGS to stdout"
complete -c pkgconf -l libs -d "print required linker flags to stdout"
complete -c pkgconf -l libs-only-L -d "print required LDPATH linker flags to stdout"
complete -c pkgconf -l libs-only-l -d "print required LIBNAME linker flags to stdout"
complete -c pkgconf -l libs-only-other -d "print required other linker flags to stdout"
complete -c pkgconf -l print-requires -d "print required dependency frameworks to stdout"
complete -c pkgconf -l print-requires-private -d "print required dependency frameworks for static linking to stdout"
complete -c pkgconf -l print-provides -d "print provided dependencies to stdout"
complete -c pkgconf -l print-variables -d "print all known variables in module to stdout"
complete -c pkgconf -l digraph -d "print entire dependency graph in graphviz 'dot' format"
complete -c pkgconf -l print-digraph-query-nodes -d "also print query nodes in 'dot' format"
complete -c pkgconf -l solution -d "print dependency graph solution in a simple format"
complete -c pkgconf -l keep-system-cflags -d "keep -I/usr/include entries in cflags output"
complete -c pkgconf -l keep-system-libs -d "keep -L/usr/lib entries in libs output"
complete -c pkgconf -l path -d "show the exact filenames for any matching .pc files"
complete -c pkgconf -l modversion -d "print the specified module's version to stdout"
complete -c pkgconf -l internal-cflags -d "do not filter 'internal' cflags from output"
complete -c pkgconf -l license -d "print the specified module's license to stdout if known"
complete -c pkgconf -l license-file -d "print the specified module's license file location to stdout if known"
complete -c pkgconf -l link-abi -d "print the link ABIs (e.g. c, c++) the module must be linked against"
complete -c pkgconf -l source -d "print the specified module's source code location to stdout if known"
complete -c pkgconf -l exists-cflags -d "add -DHAVE_FOO fragments to cflags for each found module"

# filtering output:
complete -c pkgconf -l msvc-syntax -d "print translatable fragments in MSVC syntax"
complete -c pkgconf -l fragment-filter -x -d "filter output fragments to the specified types"
complete -c pkgconf -l env -x -d "print output as shell-compatible environmental variables"
complete -c pkgconf -l fragment-tree -d "visualize printed CFLAGS/LIBS fragments as a tree"
complete -c pkgconf -l newlines -d "use newlines for whitespace between fragments"
